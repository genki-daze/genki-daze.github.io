---
/**
 * index.astro — 日本語版のトップページ（サイトの入口 '/'）
 *
 * このファイルはわざと薄く作ってあります。中身は HomeSections.astro に全部あります。
 * 直したいものがあれば、たいていは以下のどれかで、このファイルではありません:
 *   ・文章 → src/content/about/ja.md, src/content/research/ja/*.md
 *   ・業績/経歴/スキル → src/data/*.yml
 *   ・氏名・所属・リンク → src/data/profile.ts
 *   ・ボタンや見出しの文言 → src/i18n/ui.ts
 *
 * 英語版は src/pages/en/index.astro です。構造は同じで lang だけが違います。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSections from '../components/HomeSections.astro';
import { profile } from '../data/profile';

const lang = 'ja' as const;

// <title> と description は profile.ts から組み立てます。
// ここに直接書かないでください（profile.ts を直せば両方に反映されます）。
const title = `${profile.name.ja} | ${profile.affiliation.ja}`;
const description = `${profile.affiliation.ja}・${profile.name.ja}`;
---

<BaseLayout lang={lang} title={title} description={description}>
  <HomeSections lang={lang} />
</BaseLayout>
