---
/**
 * Icon.astro — インラインSVGアイコン
 *
 * 使い方:  <Icon name="github" />
 *          <Icon name="mail" class="chip__icon" />
 *
 * ・装飾目的なので常に aria-hidden="true" です。
 *   アイコン単体がリンクやボタンの中身になる場合は、呼び出し側で
 *   <span class="visually-hidden">ラベル</span> を必ず添えてください。
 * ・色は fill/stroke: currentColor。親要素の color がそのまま効きます。
 * ・大きさは global.css の .icon（1.125em 角）。変えたい時は class を渡して上書きします。
 * ・知らない name が来たら 'link' で描画します（空白にはしません）。
 */

export interface Props {
  /** アイコン名。未知の名前は 'link' にフォールバックします。 */
  name: string;
  /** .icon に追加するクラス。 */
  class?: string;
}

type IconDef = {
  /** SVG の path の d 属性。複数可。 */
  paths: string[];
  /** true なら塗りつぶしではなく線画として描画します。 */
  stroke?: boolean;
};

const icons: Record<string, IconDef> = {
  // --- ブランドマーク（塗りつぶし / 24x24）-------------------------------
  github: {
    paths: [
      'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12Z',
    ],
  },
  x: {
    paths: [
      'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231L18.244 2.25Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z',
    ],
  },
  scholar: {
    paths: [
      'M5.242 13.769 0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269Z',
      'M12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14Z',
    ],
  },
  orcid: {
    paths: [
      'M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0ZM7.369 4.378c.525 0 .947.431.947.947 0 .525-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.516.422-.947.947-.947Zm-.722 3.038h1.444v10.041H6.647V7.416Zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416Zm1.444 1.303v7.444h2.297c2.359 0 3.588-1.444 3.588-3.722 0-2.016-1.088-3.722-3.688-3.722h-2.197Z',
    ],
  },
  linkedin: {
    paths: [
      'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065Zm1.782 13.019H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0Z',
    ],
  },

  // --- UI アイコン（線画 / 24x24）---------------------------------------
  link: {
    stroke: true,
    paths: [
      'M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71',
      'M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71',
    ],
  },
  mail: {
    stroke: true,
    paths: ['M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z', 'm22 6-10 7L2 6'],
  },
  'arrow-up': {
    stroke: true,
    paths: ['M12 19V5', 'm5 12 7-7 7 7'],
  },
  external: {
    stroke: true,
    paths: ['M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6', 'M15 3h6v6', 'm10 14 11-11'],
  },
  menu: {
    stroke: true,
    paths: ['M3 6h18', 'M3 12h18', 'M3 18h18'],
  },
  close: {
    stroke: true,
    paths: ['m18 6-12 12', 'm6 6 12 12'],
  },

  // --- エイリアス --------------------------------------------------------
  // profile.ts の icon: 'email' / 'researchmap' をそのまま渡せるようにするため。
  email: {
    stroke: true,
    paths: ['M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z', 'm22 6-10 7L2 6'],
  },
  // researchmap には公開されている標準マークが無いため、汎用の「業績ページ」記号で表します。
  researchmap: {
    stroke: true,
    paths: ['M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Z', 'M14 2v6h6', 'M9 13h6', 'M9 17h6'],
  },
};

const { name, class: className } = Astro.props;

// 未知の name はフォールバック（空白のアイコンを出さない）
const icon: IconDef = icons[name] ?? icons.link;
---

{
  icon.stroke ? (
    <svg
      class:list={['icon', className]}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      {icon.paths.map((d) => (
        <path d={d} />
      ))}
    </svg>
  ) : (
    <svg
      class:list={['icon', className]}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      {icon.paths.map((d) => (
        <path d={d} />
      ))}
    </svg>
  )
}
